{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "search-poi-v2-global",
  "compatibility_date": "2026-05-16",
  "pages_build_output_dir": "./dist",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "production"
  }
}
